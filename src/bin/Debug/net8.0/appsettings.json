{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=marsbridge;Username=marsbridge;Password=password",
    "Redis": "localhost:6379",
    "RabbitMQ": "amqp://marsbridge:password@localhost:5672/"
  },
  "JWT": {
    "SecretKey": "YourVeryLongJWTSecretKeyForProductionUseMinimum64Characters2025!",
    "Issuer": "MarsBridge",
    "Audience": "MarsBridgeClients",
    "ExpiryMinutes": 60
  },
  "MarsBridge": {
    "MaxPlayersPerGame": 50,
    "ClimateUpdateIntervalSeconds": 30,
    "EnableRabbitMQ": true,
    "EnableRedisCache": false
  }
}