# MarsBridge Server - Environment Variables for Portainer
# Copy these to Portainer Stack Environment Variables

# Database Passwords
POSTGRES_PASSWORD=YourSecurePostgresPassword2025!
GRAFANA_DB_PASSWORD=YourSecureGrafanaDBPassword2025!

# Service Passwords  
RABBITMQ_PASSWORD=YourSecureRabbitMQPassword2025!
REDIS_PASSWORD=YourSecureRedisPassword2025!
GRAFANA_PASSWORD=YourSecureGrafanaPassword2025!

# Security
JWT_SECRET=YourVeryLongJWTSecretKeyForProductionUseMinimum64Characters2025!

# Optional - Domain Configuration
DOMAIN_NAME=yourdomain.com
MARSBRIDGE_SUBDOMAIN=marsbridge
RABBITMQ_SUBDOMAIN=rabbitmq

# Optional - SSL/TLS
SSL_EMAIL=your-email@yourdomain.com
ENABLE_SSL=false